<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lzj.admin.mapper.PurchaseListMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.lzj.admin.pojo.PurchaseList">
        <id column="id" property="id" />
        <result column="amount_paid" property="amountPaid" />
        <result column="amount_payable" property="amountPayable" />
        <result column="purchase_date" property="purchaseDate" />
        <result column="remarks" property="remarks" />
        <result column="state" property="state" />
        <result column="purchase_number" property="purchaseNumber" />
        <result column="supplier_id" property="supplierId" />
        <result column="user_id" property="userId" />
    </resultMap>

    <select id="getNextPurchaseNumber" resultType="java.lang.String">
        <![CDATA[
        SELECT MAX(purchase_number) AS purchaseNumber
        FROM t_purchase_list
        WHERE purchase_date >= TRUNC(SYSDATE)
          AND purchase_date < TRUNC(SYSDATE) + 1
        ]]>
    </select>
    
	<select id="queryPurchaseListByParams" resultType="com.lzj.admin.pojo.PurchaseList">
	
	    SELECT
	        p.id,
	        p.amount_paid,
	        p.amount_payable,
	        p.purchase_date,
	        p.remarks,
	        p.state,
	        p.purchase_number,
	        p.supplier_id,
	        p.user_id,
	
	        s.name supplierName,
	
	        u.user_name userName
	
	    FROM t_purchase_list p
	
	    LEFT JOIN t_supplier s
	        ON p.supplier_id = s.id
	
	    LEFT JOIN t_user u
	        ON p.user_id = u.id
	
	
	    <where>
	
	        <if test="purchaseListQuery.purchaseNumber != null
	                  and purchaseListQuery.purchaseNumber != ''">
	            AND p.purchase_number LIKE '%'||#{purchaseListQuery.purchaseNumber}||'%'
	        </if>
	
	
	        <if test="purchaseListQuery.supplierId != null">
	            AND p.supplier_id = #{purchaseListQuery.supplierId}
	        </if>
	
	
	        <if test="purchaseListQuery.state != null">
	            AND p.state = #{purchaseListQuery.state}
	        </if>
	
	
	        <if test="purchaseListQuery.startDate != null
	                  and purchaseListQuery.startDate != ''">
	            AND p.purchase_date &gt;=
	            TO_DATE(#{purchaseListQuery.startDate},'yyyy-MM-dd')
	        </if>
	
	
	        <if test="purchaseListQuery.endDate != null
	                  and purchaseListQuery.endDate != ''">
	            AND p.purchase_date &lt;
	            TO_DATE(#{purchaseListQuery.endDate},'yyyy-MM-dd') + 1
	        </if>
	
	    </where>
	
	    ORDER BY p.id DESC
	
	</select>
</mapper>
